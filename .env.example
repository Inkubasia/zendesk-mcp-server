ZENDESK_SUBDOMAIN=xxx
ZENDESK_EMAIL=xxx
ZENDESK_API_KEY=xxx

# --- Remote auth (OAuth 2.1 bearer), HTTP transport only ---------------------
# Auth is ON automatically once MCP_AUTH_ISSUER is set: /mcp then requires a
# valid bearer token. With the issuer unset the server FAILS CLOSED (refuses to
# start) — set MCP_AUTH_DISABLED=1 to run unauthenticated (dev/local only).

# Issuer URL of your OAuth 2.1 / OIDC authorization server (the `iss` claim on
# access tokens). The server discovers the JWKS from the AS metadata document
# at <issuer>/.well-known/oauth-authorization-server. Setting this enables auth.
MCP_AUTH_ISSUER=
# RFC 8707 resource identifier = this MCP endpoint's public URL. Advertised in
# the OAuth Protected Resource Metadata.
MCP_RESOURCE_URL=http://localhost:8080/mcp
# The exact value the token's `aud` must match (typically the resource URL
# registered as an OAuth Resource Indicator). Required when auth is enabled so
# tokens minted for another resource on a shared issuer are rejected.
MCP_EXPECTED_AUDIENCE=
# Set to 1 to intentionally accept ANY audience from the issuer (skips the
# aud check). Leave unset in production.
MCP_ALLOW_ANY_AUDIENCE=
# Space-separated scopes required on every token. Blank = any valid token from
# the issuer is accepted.
MCP_REQUIRED_SCOPES=
# Escape hatch for local dev: set to 1 to disable auth even when the issuer is set.
MCP_AUTH_DISABLED=
